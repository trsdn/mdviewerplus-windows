{
  "name": "mdviewerplus-windows",
  "version": "2.2.0",
  "type": "module",
  "description": "MDViewer+ for Windows — Markdown viewer and editor",
  "license": "MIT",
  "repository": "https://github.com/trsdn/mdviewerplus-windows",
  "imports": {
    "#edition": {
      "full": "./src/js/editions/full.js",
      "default": "./src/js/editions/lite.js"
    }
  },
  "scripts": {
    "dev": "npm run build:frontend:full && tauri dev --config src-tauri/tauri.full.conf.json",
    "build": "npm run build:editions",
    "build:frontend": "npm run build:frontend:full",
    "build:frontend:lite": "node scripts/build-frontend.mjs --edition=lite",
    "build:frontend:full": "node scripts/build-frontend.mjs --edition=full",
    "build:editions": "npm run build:frontend:lite && npm run build:frontend:full && npm run audit:artifacts",
    "build:installer:lite": "node scripts/build-tauri.mjs --edition=lite",
    "build:installer:full": "node scripts/build-tauri.mjs --edition=full",
    "audit:artifacts": "node scripts/audit-artifacts.mjs",
    "measure:builds": "node scripts/measure-builds.mjs",
    "test": "npm run build:editions && node --test",
    "test:frontend": "node --test",
    "test:packages": "node --test tests/package-and-build.test.js",
    "tauri": "tauri"
  },
  "dependencies": {
    "@codemirror/commands": "^6",
    "@codemirror/lang-markdown": "^6",
    "@codemirror/language": "^6",
    "@codemirror/search": "^6",
    "@codemirror/state": "^6",
    "@codemirror/view": "^6",
    "@lezer/highlight": "^1",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.2",
    "dompurify": "3.4.14",
    "highlight.js": "11.11.1",
    "js-yaml": "5.2.3",
    "marked": "^15.0.7",
    "marked-footnote": "1.4.0",
    "mermaid": "11.16.0",
    "prismjs": "1.30.0",
    "svg-pan-zoom": "3.6.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "esbuild": "0.28.1",
    "jsdom": "30.0.1"
  }
}
