{
  "identifier": "default",
  "description": "Default capabilities for MDViewer+",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-set-title",
    "core:window:allow-close",
    "core:event:default",
    "core:menu:default",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "window-state:default"
  ]
}
